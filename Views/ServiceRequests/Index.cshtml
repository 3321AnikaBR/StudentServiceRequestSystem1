@model IEnumerable<StudentServiceRequestSystem.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="full-page-bg requests-bg">

    <div class="request-panel">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>Service Requests</h1>

                <p>
                    Submit and track your requests easily.
                </p>

            </div>

            <a asp-action="Create"
               class="btn btn-success btn-lg">
                + Create New
            </a>

        </div>


        <div class="table-responsive">

            <table class="table request-table">

                <thead>

                    <tr>

                        <th>Student ID</th>

                        <th>Request Type</th>

                        <th>Description</th>

                        <th>Status</th>

                        <th>Created Date</th>

                        <th>Updated Date</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.StudentId</td>

                            <td>@item.RequestType</td>

                            <td>@item.Description</td>

                            <td>@item.Status</td>

                            <td>@item.CreatedDate</td>

                            <td>@item.UpdatedDate</td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-requestId="@item.RequestId">
                                    Edit
                                </a>

                                |

                                <a asp-action="Details"
                                   asp-route-requestId="@item.RequestId">
                                    Details
                                </a>

                                |

                                <a asp-action="Delete"
                                   asp-route-requestId="@item.RequestId">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>