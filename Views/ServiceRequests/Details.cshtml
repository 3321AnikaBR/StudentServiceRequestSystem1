@model StudentServiceRequestSystem.Models.ServiceRequest

@{
    ViewData["Title"] = "Request Details";

    string? role =
        Context.Session.GetString("Role");
}

<div class="request-details-page">

    <div class="details-card">

        <h1>Request Details</h1>

        <p class="details-subtitle">
            Review the submitted student service request.
        </p>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }


        <div class="details-row">
            <span>Student ID</span>
            <strong>@Model.StudentId</strong>
        </div>

        <div class="details-row">
            <span>Request Type</span>
            <strong>@Model.RequestType</strong>
        </div>

        <div class="details-row">
            <span>Description</span>
            <strong>@Model.Description</strong>
        </div>

        <div class="details-row">
            <span>Current Status</span>
            <strong>@Model.Status</strong>
        </div>

        <div class="details-row">
            <span>Created Date</span>
            <strong>
                @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
            </strong>
        </div>

        <div class="details-row">
            <span>Updated Date</span>
            <strong>
                @Model.UpdatedDate.ToString("dd MMM yyyy hh:mm tt")
            </strong>
        </div>


        @if (role == "Staff")
        {
            <div class="status-update-box">

                <h3>Update Request Status</h3>

                <form asp-controller="ServiceRequests"
                      asp-action="UpdateStatus"
                      method="post">

                    <input type="hidden"
                           name="requestId"
                           value="@Model.RequestId" />

                    <label class="form-label">
                        Select Status
                    </label>

                    <select name="status"
                            class="form-control mb-3">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Processing">
                            Processing
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                    </select>

                    <button type="submit"
                            class="btn btn-success">

                        Save Status

                    </button>

                </form>

            </div>
        }


        <div class="mt-4">

            @if (role == "Staff")
            {
                <a asp-controller="Account"
                   asp-action="StaffDashboard"
                   class="btn btn-outline-secondary">

                    Back to Staff Dashboard

                </a>
            }
            else
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Back to My Requests

                </a>
            }

        </div>

    </div>

</div>