@model IEnumerable<StudentServiceRequestSystem.Models.ServiceRequest>

@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="staff-page">

    <div class="staff-wrapper">

        <div class="staff-top">

            <div>
                <h1>Staff Dashboard</h1>

                <p>
                    Welcome, @ViewBag.UserName
                </p>
            </div>

            <a asp-controller="Account"
               asp-action="Logout"
               class="btn btn-light">
                Logout
            </a>

        </div>


        <div class="row g-3 mt-2">

            <div class="col-md">
                <div class="staff-stat">
                    <h2>@ViewBag.Total</h2>
                    <p>Total Requests</p>
                </div>
            </div>

            <div class="col-md">
                <div class="staff-stat">
                    <h2>@ViewBag.Pending</h2>
                    <p>Pending</p>
                </div>
            </div>

            <div class="col-md">
                <div class="staff-stat">
                    <h2>@ViewBag.Processing</h2>
                    <p>Processing</p>
                </div>
            </div>

            <div class="col-md">
                <div class="staff-stat">
                    <h2>@ViewBag.Completed</h2>
                    <p>Completed</p>
                </div>
            </div>

            <div class="col-md">
                <div class="staff-stat">
                    <h2>@ViewBag.Rejected</h2>
                    <p>Rejected</p>
                </div>
            </div>

        </div>


        <div class="staff-table-card">

            <h2>Submitted Student Requests</h2>

            <p>
                Open a request to review its details
                and update the current status.
            </p>

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Request Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.StudentId</td>

                                <td>@item.RequestType</td>

                                <td>@item.Description</td>

                                <td>
                                    <strong>@item.Status</strong>
                                </td>

                                <td>
                                    @item.CreatedDate.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <a asp-controller="ServiceRequests"
                                       asp-action="Details"
                                       asp-route-requestId="@item.RequestId"
                                       class="btn btn-success btn-sm">

                                        Open Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>