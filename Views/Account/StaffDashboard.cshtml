@model IEnumerable<StudentServiceRequestSystem.Models.ServiceRequest>

@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="staff-dashboard-page">

    <div class="staff-container">

        <div class="staff-header">

            <div>
                <h1>Staff Dashboard</h1>

                <p>
                    Welcome, @ViewBag.UserName
                </p>
            </div>

            <a asp-controller="Account"
               asp-action="Logout"
               class="btn btn-light">

                Logout

            </a>

        </div>


        <div class="row g-4 mt-2">

            <div class="col-md-3">
                <div class="staff-stat-card">

                    <h2>@ViewBag.TotalRequests</h2>

                    <p>Total Requests</p>

                </div>
            </div>


            <div class="col-md-3">
                <div class="staff-stat-card">

                    <h2>@ViewBag.PendingRequests</h2>

                    <p>Pending</p>

                </div>
            </div>


            <div class="col-md-3">
                <div class="staff-stat-card">

                    <h2>@ViewBag.InProgressRequests</h2>

                    <p>In Progress</p>

                </div>
            </div>


            <div class="col-md-3">
                <div class="staff-stat-card">

                    <h2>@ViewBag.CompletedRequests</h2>

                    <p>Completed</p>

                </div>
            </div>

        </div>


        <div class="staff-request-panel">

            <div class="staff-panel-heading">

                <div>
                    <h2>Student Service Requests</h2>

                    <p>
                        Review requests and update their current status.
                    </p>
                </div>

            </div>


            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    @TempData["Success"]

                </div>
            }


            <div class="table-responsive">

                <table class="table staff-table">

                    <thead>

                        <tr>
                            <th>Student ID</th>
                            <th>Request Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.StudentId</td>

                                <td>@item.RequestType</td>

                                <td>@item.Description</td>

                                <td>

                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.CreatedDate.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <a asp-controller="ServiceRequests"
                                       asp-action="UpdateStatus"
                                       asp-route-requestId="@item.RequestId"
                                       class="btn btn-sm btn-success">

                                        Update Status

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>