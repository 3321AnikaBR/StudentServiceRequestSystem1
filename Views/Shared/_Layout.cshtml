<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IUBAT Student Service</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/StudentServiceRequestSystem1.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom">

            <div class="container-fluid">

                <a class="navbar-brand iubat-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/iubat-logo.png"
                         alt="IUBAT Logo"
                         class="iubat-logo" />

                    <div class="brand-text">

                        <strong>IUBAT Student Service</strong>

                        <small>
                            International University of Business Agriculture and Technology
                        </small>

                    </div>

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    <ul class="navbar-nav">

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="ServiceRequests"
                               asp-action="Index">

                                Service Requests

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="ServiceRequests"
                               asp-action="Create">

                                Create Request

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- IMPORTANT -->
    <div class="container-fluid p-0">

        <main role="main">

            @RenderBody()

        </main>

    </div>


    <footer class="footer">

        <div class="container-fluid px-4">

            &copy; 2026 - IUBAT Student Service Request System

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>